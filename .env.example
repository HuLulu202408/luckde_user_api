# 配置模板：复制为 .env 后按环境填写（.env 已被 .gitignore 忽略）。
# 也可以完全不用 .env，改为在容器编排里注入同名环境变量；
# 应用在没有任何 .env 时依旧能启动，第三方登录默认关闭（见文件末尾）。

# ===== 应用 =====
APP_NAME=luckde_user_api
APP_ENV=production

# ===== MySQL =====
MYSQL_HOST=192.168.1.36
MYSQL_PORT=3307
MYSQL_DATABASE=luckde_app_users_db
MYSQL_USER=futurelucky_test
# 必填：填入 mysql 容器实际口令（与 mysql/.env 保持一致）
MYSQL_PASSWORD=

# ===== Redis =====
# 注意：Redis 容器以 --requirepass 启动时，这里必须填同一个口令。
# 不填的话 API 仍能启动，但所有需要会话的请求都会因 NOAUTH 返回 503。
REDIS_HOST=192.168.1.36
REDIS_PORT=6380
REDIS_DB=0
# 必填（Redis 开启认证时）：与 redis/.env 的 requirepass 保持一致
REDIS_PASSWORD=

# ===== 会话 =====
# 登录 Token 有效期（秒），同时决定登录响应里的 expires_in
TOKEN_TTL_SECONDS=7200

# ===== 第三方登录（留空即关闭） =====
# 留空时 /api/v1/auth/apple 与 /api/v1/auth/google 返回 503：
#   {"detail":"Apple login is disabled (APPLE_CLIENT_ID is not configured)"}
# 应用启动与其余接口不受影响。
# 需要开启时，把 Apple / Google 开发者后台的 client id 填在这里；切勿提交到仓库。
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
